# Native application runtime: GTK 4 and libadwaita windows, tabs, splits and
# surfaces driven by typed actions.
#
# Exceptions raised by callbacks that GTK runs are logged to the `"desktop_kit"`
# `::Log` source.
module DesktopKit
  VERSION = "0.1.0"

  # :nodoc:
  Log = ::Log.for("desktop_kit")
end
