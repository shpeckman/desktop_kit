      <member name="first_bit" value="1" c:identifier="FIX_FLAGS_FIRST_BIT"/>
      <member name="second_bit" value="2" c:identifier="FIX_FLAGS_SECOND_BIT"/>
      <member name="all" value="3" c:identifier="FIX_FLAGS_ALL"/>
      <member name="high" value="-2147483648" c:identifier="FIX_FLAGS_HIGH"/>
    </bitfield>
    <callback name="Func" c:type="FixFunc">
      <return-value transfer-ownership="none"><type name="gint" c:type="int"/></return-value>
      <parameters>
        <parameter name="value"><type name="gint" c:type="int"/></parameter>
        <parameter name="user_data" closure="1"><type name="gpointer" c:type="gpointer"/></parameter>
      </parameters>
    </callback>
